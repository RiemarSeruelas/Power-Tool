# Copy this file to .env. Never commit the real .env file.

# Application
PORT=5057
TRUST_PROXY=1
QR_PAYLOAD_MODE=url
PUBLIC_APP_URL=
EXPOSE_ERROR_DETAILS=false

# Local Vite development only
VITE_DEV_PORT=5173
DEV_API_TARGET=http://127.0.0.1:5057
VITE_API_ROOT=
TEST_BASE_URL=http://127.0.0.1:5057/api

# Admin credentials are authoritative and are synchronized on each restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Used only when the application initializes a database with no Reviewer.
INITIAL_REVIEWER_USERNAME=reviewer
INITIAL_REVIEWER_PASSWORD=

# PostgreSQL
POSTGRES_ENABLED=true
POSTGRES_HOST=YOUR_POSTGRES_SERVER
POSTGRES_PORT=5432
POSTGRES_DB=YOUR_DATABASE
POSTGRES_USER=YOUR_DEDICATED_APP_USER
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=app

# Keep replicas × POSTGRES_POOL_MAX below the database connection limit.
POSTGRES_POOL_MAX=20
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_RETRY_INTERVAL_MS=15000
POSTGRES_SSL=false
